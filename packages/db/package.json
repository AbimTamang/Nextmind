{
  "name": "@nextminds/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status",
    "sync": "tsx src/sync.ts",
    "check-migrations": "node ../../scripts/check-migrations.mjs",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "@nextminds/contracts": "workspace:*",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@nextminds/tsconfig": "workspace:*",
    "@types/node": "^20.17.10",
    "sequelize-cli": "^6.6.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
