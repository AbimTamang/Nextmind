{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Shared library",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "isolatedModules": false,
    "noUncheckedIndexedAccess": false
  }
}
