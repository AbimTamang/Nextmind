# Copy to .env.local for development. Never commit a filled-in copy.
NODE_ENV=development
PORT=4000

# Same database the web app uses today. Once a domain has moved to this API,
# the web app should reach it over HTTP rather than connecting directly.
DATABASE_URL=postgres://user:password@127.0.0.1:5432/nextmind_db

# Every origin allowed to send credentialed requests, comma separated.
# A wildcard will not work here - browsers reject "*" when credentials are on.
CORS_ORIGINS=http://localhost:3000

# Must match the web app's value or sessions will not validate across the split.
BETTER_AUTH_SECRET=
